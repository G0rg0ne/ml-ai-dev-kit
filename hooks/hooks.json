{
  "description": "Block agent access to secret files such as .env.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/protect_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
